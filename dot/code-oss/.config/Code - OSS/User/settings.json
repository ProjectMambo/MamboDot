{
    // ==========================================
    // 1. YOUR CUSTOM LOOK & FEEL
    // ==========================================
    "files.autoSave": "afterDelay",
    "material-code.primaryColor": "#131C27",
    "workbench.colorTheme": "Dark Modern",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'monospace', monospace",
    "editor.fontLigatures": true,
    "editor.lineHeight": 22,
    "editor.tabSize": 4,

    // ==========================================
    // 2. RUST DEVELOPMENT
    // ==========================================
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.procMacro.enable": true,
    "rust-analyzer.check.command": "clippy",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.semanticHighlighting.enabled": true,
        "editor.tabSize": 4,
        "editor.formatOnSave": true,
    },

    // ==========================================
    // 3. GLOBAL EDITOR SETTINGS
    // ==========================================
    "editor.formatOnSave": true,
    "prettier.tabWidth": 4,
    "editor.detectIndentation": false,
    "editor.guides.indentation": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
    },

    // ==========================================
    // 4. WEB DEVELOPMENT (NEXT.JS & TAILWIND)
    // ==========================================
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
    },
    "tailwindCSS.emmetCompletions": true,
    "tailwindCSS.includeLanguages": {
        "plaintext": "javascriptreact",
        "typescriptreact": "typescriptreact",
    },

    // ==========================================
    // 5. HYPRLAND & WAYBAR DOTFILES
    // ==========================================
    "files.associations": {
        "config": "jsonc",
        "*.jsonc": "jsonc",
        "*.conf": "hyprlang",
        "hyprland.conf": "hyprlang",
        "*.sh": "shellscript",
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "css.lint.unknownAtRules": "ignore",
        "css.lint.validProperties": [
            "all",
            "background-image",
            "border-radius",
            "background-clip",
            "-gtk-icon-transform",
            "-gtk-icon-shadow",
            "-gtk-icon-effect",
            "-gtk-icon-palette",
        ],
    },

    // ==========================================
    // 6. PYTHON DEVELOPMENT
    // ==========================================
    "python.languageServer": "Default",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
        },
    },

    // ==========================================
    // 7. JAVA DEVELOPMENT
    // ==========================================
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    "java.format.settings.profile": "GoogleStyle",
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
    },

    // Workspace stubs mapping if you use the Lua flavor of Hyprland
    "Lua.workspace.library": ["/usr/share/hypr/stubs"],

    "servers": {},
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "console-ninja.featureSet": "Community",
    "redhat.telemetry.enabled": false,
}
