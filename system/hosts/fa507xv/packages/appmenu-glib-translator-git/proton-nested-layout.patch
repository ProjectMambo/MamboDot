@@ -213,0 +214,19 @@ static void menu_item_copy_and_load(DBusMenuModel *menu, DBusMenuItem *old, DBus
+static bool layout_item_get(GVariant *value, guint *id, GVariant **props)
+{
+	if (!g_variant_is_container(value) || g_variant_n_children(value) < 2)
+		return false;
+
+	g_autoptr(GVariant) item_id = g_variant_get_child_value(value, 0);
+	GVariant *item_props = g_variant_get_child_value(value, 1);
+	if (!g_variant_is_of_type(item_id, G_VARIANT_TYPE_INT32) ||
+	    !g_variant_is_of_type(item_props, G_VARIANT_TYPE_VARDICT))
+	{
+		g_variant_unref(item_props);
+		return false;
+	}
+
+	*id = (guint)g_variant_get_int32(item_id);
+	*props = item_props;
+	return true;
+}
